{
  "name": "nimiapp-storybook",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "nimi-app dev --shell electron",
    "dev:renderer": "vite --host 127.0.0.1 --port 1473 --strictPort",
    "dev:shell": "nimi-app dev",
    "dev:electron": "nimi-app dev --shell electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/bundle-electron-preload.mjs",
    "typecheck:renderer": "tsc --noEmit",
    "typecheck:electron": "tsc -p tsconfig.electron.json --noEmit",
    "typecheck": "pnpm run typecheck:renderer && pnpm run typecheck:electron",
    "build": "pnpm run typecheck && pnpm run build:renderer && pnpm run build:electron",
    "build:shell": "pnpm run build:electron",
    "lint": "pnpm run typecheck && eslint . --max-warnings 0",
    "test": "node --test test/*.test.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run lint",
    "validate": "nimi-app check",
    "local-audit": "node scripts/local-audit.mjs",
    "pack": "nimi-app pack",
    "nimicoding": "nimicoding",
    "nimicoding:doctor": "nimicoding doctor",
    "spec:authority:check": "nimicoding authority check .nimi/spec",
    "spec:authority:compile": "nimicoding authority compile .nimi/spec",
    "sync": "nimi-app sync",
    "postinstall": "install-electron",
    "build:electron:production": "node scripts/clean-electron-production.mjs && pnpm run build && node scripts/package-electron-production.mjs"
  },
  "dependencies": {
    "i18next": "^25.10.10",
    "lucide-react": "^0.577.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^16.6.6",
    "zustand": "^5.0.13",
    "@nimiplatform/sdk": "^0.10.0",
    "@nimiplatform/kit": "^0.6.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "42.5.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^7.3.6",
    "@nimiplatform/app-tools": "^0.3.0",
    "@nimiplatform/nimi-coding": "0.6.2"
  },
  "author": "Nimi Team",
  "license": "Apache-2.0",
  "main": "dist-electron/main.js"
}
